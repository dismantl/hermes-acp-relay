{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/New_York",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "ACP compatibility is owned by the exact constraint in the pinned hermes-agent[acp] extra; never update it independently.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["agent-client-protocol"],
      "enabled": false
    },
    {
      "description": "acab-ansible's tested Hermes promotion workflow owns this git revision and regenerates uv.lock; Renovate must not advance it independently.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["hermes-agent"],
      "enabled": false
    },
    {
      "description": "Automerge passing patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Keep uv releases, Docker images, and setup-uv action updates in one PR, even when their update types differ.",
      "matchPackageNames": [
        "uv",
        "astral-sh/uv",
        "https://github.com/astral-sh/uv",
        "ghcr.io/astral-sh/uv",
        "astral-sh/setup-uv",
        "https://github.com/astral-sh/setup-uv"
      ],
      "groupName": "uv toolchain",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ]
}
